# Copy to .env.local for local development. In production, set these in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender shown on enquiry emails. The domain must be verified in Resend.
CONTACT_FROM_EMAIL="Northstar Website <website@northstar-removals.com>"

# Where quote-form enquiries are delivered.
CONTACT_TO_EMAIL=info@northstar-removals.com

# Sender of the customer acknowledgement. Must be on the verified domain;
# info@ so customer replies land in the office inbox. Optional.
CONTACT_ACK_FROM_EMAIL="Northstar Removals <info@northstar-removals.com>"

# Optional. Google Search Console "HTML tag" verification token (the value of
# content="..." only). Leave unset if verifying via DNS as a Domain property.
# GOOGLE_SITE_VERIFICATION=
